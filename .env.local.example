# Required: Postgres connection string. A free Neon database works great.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Optional (SINGLE-USER / LOCAL ONLY): a personal OpenRouter key so you don't
# have to paste it into Settings. This fallback is IGNORED on any multi-user or
# public deploy (Vercel, or REQUIRE_AUTH=1) — there, every user brings their own
# key and no key is ever shared. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Set to 1 to REQUIRE login (multi-user mode) even off Vercel. Do this for ANY
# public/self-hosted deployment — otherwise, until the first account is created,
# the app runs open in single-user mode.
REQUIRE_AUTH=

# STRONGLY RECOMMENDED for any multi-user/public deploy: master key for
# encrypting secrets at rest (OpenRouter/provider API keys, custom-tool secrets,
# MCP tokens) with AES-256-GCM. With this set, the database only ever stores
# ciphertext, so a database-only compromise can't reveal anyone's keys.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK IT UP: if you lose this key, previously-encrypted secrets are
# unrecoverable (users would have to re-enter their keys). If unset, secrets are
# stored as plaintext (fine for a trusted single-user local install).
LIBERDE_SECRET_KEY=

# Optional: Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: secret for the Vercel Cron endpoint (/api/cron) that runs scheduled tasks
CRON_SECRET=

# Optional: Resend transactional email — enables password reset (and email
# verification). Sign up at resend.com, verify your sending domain, then set:
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
